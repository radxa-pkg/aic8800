From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NomDeTom <nomdetom@protonmail.com>
Date: Wed, 28 Oct 2026 00:00:00 +0000
Subject: [PATCH] usb: keep the connect time in 64-bit jiffies

An AP start waits while a STA on the chip joins and for 3 s after its
connect indication, timed from rwnx_hw->last_connect_ind. In unsigned long
jiffies on a 32-bit host, a connect from about 25 days before (at HZ=1000)
compares as being in the future: every AP start would then wait its full
8 s, for as long again, on a box that stays up and reconnects rarely.

The time is now kept as get_jiffies_64() and compared with time_before64(),
which does not wrap; it is never 0, so the "jiffies ? jiffies : 1" guard
goes.
---
 src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_defs.h   | 2 +-
 src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c   | 2 +-
 src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_msg_rx.c | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_defs.h b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_defs.h
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_defs.h
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_defs.h
@@ -794,7 +794,7 @@ struct rwnx_hw {
     #endif
     struct rwnx_survey_info survey[SCAN_CHANNEL_MAX];
     struct cfg80211_scan_request *scan_request;
-    unsigned long last_connect_ind;             /* jiffies of the last successful SM_CONNECT_IND; 0: none */
+    u64 last_connect_ind;                       /* 64-bit jiffies of the last successful SM_CONNECT_IND; 0: none */
 #ifdef CONFIG_SCHED_SCAN
     struct cfg80211_sched_scan_request *sched_scan_req;
 #endif
diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c
@@ -4171,7 +4171,7 @@ static bool rwnx_sta_joining(struct rwnx_hw *rwnx_hw)
             return true;
     }
     return rwnx_hw->last_connect_ind &&
-           time_before(jiffies, rwnx_hw->last_connect_ind + msecs_to_jiffies(AP_START_JOIN_SETTLE_MS));
+           time_before64(get_jiffies_64(), rwnx_hw->last_connect_ind + msecs_to_jiffies(AP_START_JOIN_SETTLE_MS));
 }
 
 /**
diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_msg_rx.c b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_msg_rx.c
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_msg_rx.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_msg_rx.c
@@ -928,7 +928,7 @@ static inline int rwnx_rx_sm_connect_ind(struct rwnx_hw *rwnx_hw,
 
     aicwf_join_watch_stop(rwnx_hw);
     if (!ind->status_code) {
-        rwnx_hw->last_connect_ind = jiffies ? jiffies : 1;
+        rwnx_hw->last_connect_ind = get_jiffies_64();
     }
 	
 	if(!rwnx_vif){
