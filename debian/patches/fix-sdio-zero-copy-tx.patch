+/*
+ * One CMD53 block write of the buffers of list to the fixed address addr:
+ * the host's DMA reads each buffer, nothing is copied. len is their sum, a
+ * multiple of the block size; sg holds the scatterlist built from list.
+ * Vendor kernels add an sdio_write_sg() to the MMC core; mainline has none.
+ * The caller holds the host.
+ */
+static int aicwf_sdio_write_sg(struct sdio_func *func, unsigned int addr,
+			       struct tx_scatterlist *list, struct scatterlist *sg,
+			       int nents, unsigned int len)
+{
+	struct mmc_card *card = func->card;
+	struct mmc_host *host = card->host;
+	struct mmc_request mrq = {};
+	struct mmc_command cmd = {};
+	struct mmc_data data = {};
+	unsigned int blksz = func->cur_blksize;
+	unsigned int sum = 0;
+	int i, n = 0;
+
+	if (nents > SDIO_TX_SLIST_MAX || nents > host->max_segs || !card->cccr.multi_block)
+		return -EINVAL;
+	sg_init_table(sg, nents);
+	for (i = 0; i < nents; i++) {
+		if (!list[i].len)
+			continue;
+		sg_set_buf(&sg[n++], list[i].buf, list[i].len);
+		sum += list[i].len;
+	}
+	if (!n || sum != len || len % blksz || len / blksz > 511 ||
+		len / blksz > host->max_blk_count || len > host->max_req_size)
+		return -EINVAL;
+	sg_mark_end(&sg[n - 1]);
+
+	cmd.opcode = SD_IO_RW_EXTENDED;
+	cmd.arg = 0x80000000 | func->num << 28 | 0x08000000 | (addr & 0x1ffff) << 9 | len / blksz;
+	cmd.flags = MMC_RSP_SPI_R5 | MMC_RSP_R5 | MMC_CMD_ADTC;
+	data.blksz = blksz;
+	data.blocks = len / blksz;
+	data.flags = MMC_DATA_WRITE;
+	data.sg = sg;
+	data.sg_len = n;
+	mrq.cmd = &cmd;
+	mrq.data = &data;
+	mmc_set_data_timeout(&data, card);
+	mmc_wait_for_req(host, &mrq);
+
+	if (cmd.error)
+		return cmd.error;
+	if (data.error)
+		return data.error;
+	if (!mmc_host_is_spi(host)) {
+		if (cmd.resp[0] & R5_ERROR)
+			return -EIO;
+		if (cmd.resp[0] & R5_FUNCTION_NUMBER)
+			return -EINVAL;
+		if (cmd.resp[0] & R5_OUT_OF_RANGE)
+			return -ERANGE;
+	}
+	return 0;
+}
