 	struct rwnx_cmd *cmd;
@@ -346,6 +355,7 @@ static int rwnx_send_msg(struct aic_sdio_dev *sdiodev, const void *msg_params,
 	cmd->reqid   = reqid;
 	cmd->a2e_msg = msg;
 	cmd->e2a_msg = cfm;
+	cmd->e2a_len = cfm ? (u16)min_t(size_t, cfm_len, 0xffff) : 0;
 	if (nonblock)
 		cmd->flags = RWNX_CMD_FLAG_NONBLOCK;
 	if (reqcfm)
