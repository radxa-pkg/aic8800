             if (hw_rxhdr->flags_sta_idx != RWNX_INVALID_STA) {
                 struct rwnx_sta *sta;
 
@@ -2768,7 +2774,8 @@ check_len_update:
                 rwnx_rx_statistic(rwnx_hw, hw_rxhdr, sta);
 
                 if (sta->vlan_idx != rwnx_vif->vif_index) {
-                    rwnx_vif = rwnx_hw->vif_table[sta->vlan_idx];
