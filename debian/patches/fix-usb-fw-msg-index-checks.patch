Description: fdrv/aic_load_fw usb: range-check firmware-supplied message ids and vif/sta/chan indices
 USB counterpart of "fdrv/bsp: range-check firmware-supplied message ids
 and vif/sta/chan indices": validate firmware E2A message indices before
 dispatch in the USB fdrv, bound the handler-table lookup in fdrv and
 aic_load_fw, and check sta_idx/dst_idx/vlan_idx in the USB rx data
 path.
 .
 As on SDIO: SM_CONNECT_IND only has its ap/ch/width indices checked
 when status_code is 0, so a failed connect still reaches the handler;
 SCANU_RESULT_IND requires ind->length to cover the probe response fixed
 fields; and MESH_PATH_UPDATE_IND only checks nhop_sta_idx when the
 update is not a delete.
Author: N Oliver <3945917+PixnBits@users.noreply.github.com>
Forwarded: no
Last-Update: 2026-10-26
---
 .../aic8800/aic8800_fdrv/rwnx_msg_rx.c        | 150 +++++++++++++++++-
 .../drivers/aic8800/aic8800_fdrv/rwnx_rx.c    |  13 +-
 .../aic8800/aic_load_fw/aicbluetooth_cmds.c   |  10 +-
 3 files changed, 166 insertions(+), 7 deletions(-)

diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_msg_rx.c b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_msg_rx.c
index e89681a..77f4093 100644
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_msg_rx.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_msg_rx.c
@@ -1732,16 +1732,162 @@ static msg_cb_fct *msg_hdlrs[] = {
 /**
  *
  */
+/* number of entries in each per-task handler table (msg_hdlrs rows) */
+static const unsigned int msg_hdlrs_n[] = {
+	[TASK_MM]    = ARRAY_SIZE(mm_hdlrs),
+	[TASK_DBG]   = ARRAY_SIZE(dbg_hdlrs),
+#ifdef CONFIG_RWNX_FULLMAC
+	[TASK_TDLS]  = ARRAY_SIZE(tdls_hdlrs),
+	[TASK_SCANU] = ARRAY_SIZE(scan_hdlrs),
+	[TASK_ME]    = ARRAY_SIZE(me_hdlrs),
+	[TASK_SM]    = ARRAY_SIZE(sm_hdlrs),
+	[TASK_APM]   = ARRAY_SIZE(apm_hdlrs),
+	[TASK_MESH]  = ARRAY_SIZE(mesh_hdlrs),
+#endif
+};
+
+#define RWNX_VIF_MAX  NX_VIRT_DEV_MAX
+#define RWNX_STA_MAX  (NX_REMOTE_STA_MAX + NX_VIRT_DEV_MAX)
+#define RWNX_BAD(cond, fmt, ...) do { if (unlikely(cond)) { \
+	pr_warn_ratelimited("rwnx: drop fw msg 0x%x: " fmt "\n", msg->id, ##__VA_ARGS__); return false; } } while (0)
+#define RWNX_P(type) ((const struct type *)msg->param)
+#define RWNX_VIF_PRESENT(i) ((i) < RWNX_VIF_MAX && rwnx_hw->vif_table[(i)])
+
+/*
+ * central validation of firmware-supplied indices/lengths before any handler or
+ * confirmation copy runs. Out of range -> the message is dropped (rate-limited warning).
+ * msg->param_len has already been checked against the received SDIO buffer, and the buffer is
+ * zero-padded to sizeof(struct ipc_e2a_msg), so reading these fixed fields is in bounds.
+ */
+static bool rwnx_fw_msg_valid(struct rwnx_hw *rwnx_hw, const struct ipc_e2a_msg *msg)
+{
+	switch (msg->id) {
+	case MM_PS_CHANGE_IND:
+		RWNX_BAD(RWNX_P(mm_ps_change_ind)->sta_idx >= RWNX_STA_MAX, "sta_idx %u", RWNX_P(mm_ps_change_ind)->sta_idx);
+		RWNX_BAD(rwnx_hw->sta_table[RWNX_P(mm_ps_change_ind)->sta_idx].vif_idx >= RWNX_VIF_MAX, "sta vif");
+		break;
+	case MM_TRAFFIC_REQ_IND:
+		RWNX_BAD(RWNX_P(mm_traffic_req_ind)->sta_idx >= RWNX_STA_MAX, "sta_idx %u", RWNX_P(mm_traffic_req_ind)->sta_idx);
+		RWNX_BAD(!RWNX_VIF_PRESENT(rwnx_hw->sta_table[RWNX_P(mm_traffic_req_ind)->sta_idx].vif_idx), "sta vif");
+		break;
+	case MM_P2P_VIF_PS_CHANGE_IND:
+		RWNX_BAD(RWNX_P(mm_p2p_vif_ps_change_ind)->vif_index >= RWNX_VIF_MAX, "vif %u", RWNX_P(mm_p2p_vif_ps_change_ind)->vif_index);
+		break;
+	case MM_RSSI_STATUS_IND:
+		RWNX_BAD(RWNX_P(mm_rssi_status_ind)->vif_index >= RWNX_VIF_MAX, "vif %u", RWNX_P(mm_rssi_status_ind)->vif_index);
+		break;
+	case MM_PKTLOSS_IND:
+		RWNX_BAD(RWNX_P(mm_pktloss_ind)->vif_index >= RWNX_VIF_MAX, "vif %u", RWNX_P(mm_pktloss_ind)->vif_index);
+		break;
+	case MM_CSA_COUNTER_IND:
+		RWNX_BAD(RWNX_P(mm_csa_counter_ind)->vif_index >= RWNX_VIF_MAX, "vif");
+		break;
+	case MM_CSA_FINISH_IND:
+		RWNX_BAD(RWNX_P(mm_csa_finish_ind)->vif_index >= RWNX_VIF_MAX, "vif");
+		RWNX_BAD(RWNX_P(mm_csa_finish_ind)->chan_idx >= NX_CHAN_CTXT_CNT && RWNX_P(mm_csa_finish_ind)->chan_idx != RWNX_CH_NOT_SET, "chan");
+		break;
+	case MM_CSA_TRAFFIC_IND:
+		RWNX_BAD(RWNX_P(mm_csa_traffic_ind)->vif_index >= RWNX_VIF_MAX, "vif");
+		break;
+	case MM_CHANNEL_SWITCH_IND:
+		RWNX_BAD(RWNX_P(mm_channel_switch_ind)->chan_index >= NX_CHAN_CTXT_CNT &&
+		       RWNX_P(mm_channel_switch_ind)->chan_index != RWNX_CH_NOT_SET, "chan %u", RWNX_P(mm_channel_switch_ind)->chan_index);
+		break;
+	case MM_REMAIN_ON_CHANNEL_EXP_IND:
+		RWNX_BAD(RWNX_P(mm_remain_on_channel_exp_ind)->vif_index >= RWNX_VIF_MAX, "vif");
+		break;
+	case MM_P2P_NOA_UPD_IND:
+		RWNX_BAD(RWNX_P(mm_p2p_noa_upd_ind)->vif_index >= RWNX_VIF_MAX, "vif");
+		break;
+	case MM_APM_STALOSS_IND:
+		RWNX_BAD(RWNX_P(mm_apm_staloss_ind)->vif_idx >= RWNX_VIF_MAX, "vif");
+		break;
+	case ME_TKIP_MIC_FAILURE_IND:
+		RWNX_BAD(!RWNX_VIF_PRESENT(RWNX_P(me_tkip_mic_failure_ind)->vif_idx), "vif %u", RWNX_P(me_tkip_mic_failure_ind)->vif_idx);
+		break;
+	case ME_TX_CREDITS_UPDATE_IND:
+		RWNX_BAD(RWNX_P(me_tx_credits_update_ind)->sta_idx >= RWNX_STA_MAX, "sta");
+		RWNX_BAD(RWNX_P(me_tx_credits_update_ind)->tid >= NX_NB_TXQ_PER_STA, "tid");
+		break;
+	case SM_CONNECT_IND: {
+		const struct sm_connect_ind *ind = RWNX_P(sm_connect_ind);
+		RWNX_BAD(!RWNX_VIF_PRESENT(ind->vif_idx), "vif %u", ind->vif_idx);
+		/* the handler only uses ap/ch/width on success; a failed connect must still reach it */
+		if (ind->status_code == 0) {
+			RWNX_BAD(ind->ap_idx >= RWNX_STA_MAX, "ap_idx %u", ind->ap_idx);
+			RWNX_BAD(ind->ch_idx >= NX_CHAN_CTXT_CNT, "ch_idx %u", ind->ch_idx);
+			RWNX_BAD(ind->width > PHY_CHNL_BW_80P80, "width %u", ind->width);
+		}
+		RWNX_BAD((u32)ind->assoc_req_ie_len + ind->assoc_rsp_ie_len > sizeof(ind->assoc_ie_buf),
+		       "ie lens %u+%u", ind->assoc_req_ie_len, ind->assoc_rsp_ie_len);
+		break;
+	}
+	case SM_DISCONNECT_IND:
+		RWNX_BAD(!RWNX_VIF_PRESENT(RWNX_P(sm_disconnect_ind)->vif_idx), "vif %u", RWNX_P(sm_disconnect_ind)->vif_idx);
+		break;
+	case SM_EXTERNAL_AUTH_REQUIRED_IND:
+		RWNX_BAD(!RWNX_VIF_PRESENT(RWNX_P(sm_external_auth_required_ind)->vif_idx), "vif");
+		break;
+	case SCANU_RESULT_IND: {
+		const struct scanu_result_ind *ind = RWNX_P(scanu_result_ind);
+		RWNX_BAD(msg->param_len < offsetof(struct scanu_result_ind, payload) ||
+		       ind->length < offsetof(struct ieee80211_mgmt, u.probe_resp.variable) ||
+		       ind->length > msg->param_len - offsetof(struct scanu_result_ind, payload),
+		       "scan frame len %u > param %u", ind->length, msg->param_len);
+		RWNX_BAD(ind->sta_idx >= RWNX_STA_MAX && ind->sta_idx != 0xFF, "sta");
+		break;
+	}
+	case TDLS_CHAN_SWITCH_IND:
+		RWNX_BAD(RWNX_P(tdls_chan_switch_ind)->vif_index >= RWNX_VIF_MAX ||
+		       RWNX_P(tdls_chan_switch_ind)->chan_ctxt_index >= NX_CHAN_CTXT_CNT, "tdls idx");
+		break;
+	case TDLS_CHAN_SWITCH_BASE_IND:
+		RWNX_BAD(RWNX_P(tdls_chan_switch_base_ind)->vif_index >= RWNX_VIF_MAX ||
+		       RWNX_P(tdls_chan_switch_base_ind)->chan_ctxt_index >= NX_CHAN_CTXT_CNT, "tdls idx");
+		break;
+	case TDLS_PEER_PS_IND:
+		RWNX_BAD(RWNX_P(tdls_peer_ps_ind)->vif_index >= RWNX_VIF_MAX ||
+		       RWNX_P(tdls_peer_ps_ind)->sta_idx >= RWNX_STA_MAX, "tdls idx");
+		break;
+	case MESH_PATH_CREATE_CFM:
+		RWNX_BAD(RWNX_P(mesh_path_create_cfm)->vif_idx >= RWNX_VIF_MAX, "vif");
+		break;
+	case MESH_PEER_UPDATE_IND:
+		RWNX_BAD(!RWNX_VIF_PRESENT(RWNX_P(mesh_peer_update_ind)->vif_idx) ||
+		       RWNX_P(mesh_peer_update_ind)->sta_idx >= RWNX_STA_MAX, "mesh idx");
+		break;
+	case MESH_PATH_UPDATE_IND:
+		RWNX_BAD(!RWNX_VIF_PRESENT(RWNX_P(mesh_path_update_ind)->vif_idx) ||
+		       (!RWNX_P(mesh_path_update_ind)->delete &&
+			RWNX_P(mesh_path_update_ind)->nhop_sta_idx >= RWNX_STA_MAX), "mesh idx");
+		break;
+	case MESH_PROXY_UPDATE_IND:
+		RWNX_BAD(!RWNX_VIF_PRESENT(RWNX_P(mesh_proxy_update_ind)->vif_idx), "vif");
+		break;
+	default:
+		break;
+	}
+	return true;
+}
+
 void rwnx_rx_handle_msg(struct rwnx_hw *rwnx_hw, struct ipc_e2a_msg *msg)
 {
+	unsigned int t = MSG_T(msg->id), i = MSG_I(msg->id);
+	msg_cb_fct cb = NULL;
+
 	//printk("%s(%d) MSG_T(msg->id):%d MSG_I(msg->id):%d cmd:%s\r\n", __func__, 
 	//	msg->id,
 	//	MSG_T(msg->id), 
 	//	MSG_I(msg->id),
 	//	rwnx_id2str[MSG_T(msg->id)][MSG_I(msg->id)]);
 	
-    rwnx_hw->cmd_mgr->msgind(rwnx_hw->cmd_mgr, msg,
-                            msg_hdlrs[MSG_T(msg->id)][MSG_I(msg->id)]);
+	/* the handler tables are indexed by a firmware-supplied id */
+	if (t < ARRAY_SIZE(msg_hdlrs) && msg_hdlrs[t] && t < ARRAY_SIZE(msg_hdlrs_n) && i < msg_hdlrs_n[t])
+		cb = msg_hdlrs[t][i];
+	if (!rwnx_fw_msg_valid(rwnx_hw, msg))
+		return;
+
+	rwnx_hw->cmd_mgr->msgind(rwnx_hw->cmd_mgr, msg, cb);
 }
 
