diff --git a/src/USB/driver_fw/drivers/aic8800/aic_load_fw/aicbluetooth_cmds.c b/src/USB/driver_fw/drivers/aic8800/aic_load_fw/aicbluetooth_cmds.c
index d6320b1..774e889 100644
--- a/src/USB/driver_fw/drivers/aic8800/aic_load_fw/aicbluetooth_cmds.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic_load_fw/aicbluetooth_cmds.c
@@ -462,8 +462,14 @@ static msg_cb_fct *msg_hdlrs[] = {
 
 void rwnx_rx_handle_msg(struct aic_usb_dev *usbdev, struct ipc_e2a_msg *msg)
 {
-    usbdev->cmd_mgr.msgind(&usbdev->cmd_mgr, msg,
-                            msg_hdlrs[MSG_T(msg->id)][MSG_I(msg->id)]);
+    /* firmware-supplied id indexes the handler tables */
+    unsigned int t = MSG_T(msg->id), i = MSG_I(msg->id);
+    msg_cb_fct cb = NULL;
+
+    if (t == TASK_DBG && i < ARRAY_SIZE(dbg_hdlrs))
+        cb = dbg_hdlrs[i];
+    (void)msg_hdlrs;
+    usbdev->cmd_mgr.msgind(&usbdev->cmd_mgr, msg, cb);
 }
 
 
