+                    rwnx_vif = sta->vlan_idx < NX_VIRT_DEV_MAX + NX_REMOTE_STA_MAX ? rwnx_hw->vif_table[sta->vlan_idx] : NULL;
                     if (!rwnx_vif) {
                         dev_kfree_skb(skb);
                         goto end;
@@ -2861,7 +2868,7 @@ check_len_update:
 					} else {
 						/* unicast pkt for STA inside the BSS, no need to forward to upper
 						   layer simply resend on wireless interface */
-						if ((flags_dst_idx != RWNX_INVALID_STA) && !flags_is_amsdu) {
