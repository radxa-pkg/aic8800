+/*
+ * The vendor fallback MAC is 88:00:33:77 plus two random bytes, so it
+ * changes at each module load. Use a stable source if the board has one:
+ *
+ *  1. The device tree node of the SDIO function: "mac-address",
+ *     "local-mac-address" or an nvmem cell.
+ *  2. The "serial-number" property of the device tree root, which
+ *     U-Boot sets from its serial# variable. A hash of it replaces the
+ *     two random bytes.
+ *
+ * Return false if there is no stable source.
+ */
+static bool rwnx_get_stable_dflt_mac(struct device *dev, u8 *mac)
+{
+	struct device_node *root;
+	const char *serial;
+	bool found = false;
+	u32 hash;
+
+	if (dev && dev->of_node) {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 13, 0)
+		if (!of_get_mac_address(dev->of_node, mac))
+			return true;
+#else
+		const void *addr = of_get_mac_address(dev->of_node);
+
+		if (!IS_ERR_OR_NULL(addr)) {
+			ether_addr_copy(mac, addr);
+			return true;
+		}
+#endif
+	}
+
+	root = of_find_node_by_path("/");
+	if (!root)
+		return false;
+
+	if (!of_property_read_string(root, "serial-number", &serial) && *serial) {
+		hash = jhash(serial, strlen(serial), 0);
+		mac[4] = hash & 0xff;
+		mac[5] = (hash >> 8) & 0xff;
+		found = true;
+	}
+	of_node_put(root);
+
+	return found;
+}
