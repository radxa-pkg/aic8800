From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NomDeTom <nomdetom@protonmail.com>
Date: Fri, 23 Oct 2026 00:00:00 +0100
Subject: [PATCH] usb: set the stall watch's work up at probe

aicwf_bus_deinit() cancels the stall watch on every teardown, the probe's
failure paths included. Its work was set up in rwnx_cmd_mgr_init(), reached
only through platform initialisation, so a probe that failed earlier (in
aicwf_bus_init(), aicwf_bus_start(), or the first allocation of
aicwf_rwnx_usb_platform_init()) cancelled a zeroed work item, and the
workqueue's flush warns on a work with no function.

The work is now set up in aicwf_usb_probe() straight after the device is
allocated, once for the device's lifetime, so every cleanup path finds it
initialised.
---
 src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/aicwf_usb.c | 2 ++
 src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.c | 6 ++----
 src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.h | 1 +
 3 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/aicwf_usb.c b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/aicwf_usb.c
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/aicwf_usb.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/aicwf_usb.c
@@ -2414,6 +2414,8 @@ static int aicwf_usb_probe(struct usb_interface *intf, const struct usb_device_i
         AICWFDBG(LOGERROR, "%s usb_dev kzalloc fail\r\n", __func__);
         return -ENOMEM;
     }
+    /* Before anything can fail: every cleanup path cancels the stall watch (aicwf_bus_deinit). */
+    INIT_DELAYED_WORK(&usb_dev->join_watch_work, join_watch_tick);
 
     usb_dev->usb_tx_buf = vmalloc(sizeof(struct aicwf_usb_buf) * AICWF_USB_TX_URBS);
     usb_dev->usb_rx_buf = vmalloc(sizeof(struct aicwf_usb_buf) * AICWF_USB_RX_URBS);
diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.c b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.c
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.c
@@ -183,7 +183,8 @@ MODULE_PARM_DESC(stall_watch, "Watch joins and disconnects for a stalled firmwar
 
 static void cmd_mgr_reset_device(struct rwnx_cmd_mgr *cmd_mgr);
 
-static void join_watch_tick(struct work_struct *work)
+/* Set up at probe (aicwf_usb_probe), before any path that cancels it. */
+void join_watch_tick(struct work_struct *work)
 {
     struct aic_usb_dev *usbdev = container_of(to_delayed_work(work), struct aic_usb_dev, join_watch_work);
     unsigned int ms = jiffies_to_msecs(jiffies - usbdev->join_watch_since), stuck;
@@ -849,9 +850,6 @@ void rwnx_cmd_mgr_init(struct rwnx_cmd_mgr *cmd_mgr)
     RWNX_DBG(RWNX_FN_ENTRY_STR);
 
     INIT_LIST_HEAD(&cmd_mgr->cmds);
-#ifdef AICWF_USB_SUPPORT
-    INIT_DELAYED_WORK(&container_of(cmd_mgr, struct aic_usb_dev, cmd_mgr)->join_watch_work, join_watch_tick);
-#endif
 	cmd_mgr->state = RWNX_CMD_MGR_STATE_INITED;
     spin_lock_init(&cmd_mgr->lock);
     cmd_mgr->max_queue_sz = RWNX_CMD_MAX_QUEUED;
diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.h b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.h
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.h
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.h
@@ -119,6 +119,7 @@ void aicwf_join_watch_start(struct rwnx_hw *rwnx_hw);
 void aicwf_join_watch_stop(struct rwnx_hw *rwnx_hw);
 struct aic_usb_dev;
 void aicwf_join_watch_cancel(struct aic_usb_dev *usbdev);
+void join_watch_tick(struct work_struct *work);
 int cmd_mgr_queue_force_defer(struct rwnx_cmd_mgr *cmd_mgr, struct rwnx_cmd *cmd);
 void aicwf_set_cmd_tx(void *dev, struct lmac_msg *msg, uint len);
 void cmd_mgr_task_process(struct work_struct *work);
