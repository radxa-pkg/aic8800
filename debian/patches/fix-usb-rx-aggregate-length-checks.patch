+/* Bytes that may be read: the URB length, and not past the allocation. */
+static u32 aicwf_rxbuff_rem(const struct rx_buff *buffer, const u8 *p)
+{
+	size_t bytes;
+
+	if (!buffer->start || !p || p < buffer->start || p >= buffer->end)
+		return 0;
+	bytes = (size_t)(buffer->end - p);
+	if (bytes > buffer->len)
+		bytes = buffer->len;
+	return (u32)bytes;
+}
