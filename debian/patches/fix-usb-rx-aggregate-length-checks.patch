+/* copy_n is the memcpy length. step is how far the cursor moves, padded to
+ * RX_ALIGNMENT when align is set. u32 so pkt_len + RX_HWHRD_LEN cannot wrap.
+ */
+static bool aicwf_rx_lens(u32 rem, u16 pkt_len, bool cfg, bool align,
+			  u32 *copy_n, u32 *step)
+{
+	u32 n, adv;
+
+	if (rem < 4)
+		return false;
+	if (cfg) {
+		n = (u32)pkt_len + 4;
+		adv = (u32)pkt_len;
+		if (align && (adv & (RX_ALIGNMENT - 1)))
+			adv = (adv + (RX_ALIGNMENT - 1)) & ~(u32)(RX_ALIGNMENT - 1);
+		adv += 4;
+	} else {
+		n = (u32)pkt_len + RX_HWHRD_LEN;
+		adv = n;
+		if (align && (adv & (RX_ALIGNMENT - 1)))
+			adv = (adv + (RX_ALIGNMENT - 1)) & ~(u32)(RX_ALIGNMENT - 1);
+	}
+	if (n > rem)
+		return false;
+	*copy_n = n;
+	*step = adv;
+	return true;
+}
+
+static bool aicwf_e2a_ok(struct ipc_e2a_msg *em, u32 msg_len)
+{
+	const u32 hdr = offsetof(struct ipc_e2a_msg, param);
+	u32 room;
+
+	if (msg_len < hdr) {
+		pr_warn_ratelimited("rwnx: short e2a msg %u\n", msg_len);
+		return false;
+	}
+	room = msg_len - hdr;
+	if (room > sizeof(em->param))
+		room = sizeof(em->param);
+	if (em->param_len > room) {
+		pr_warn_ratelimited("rwnx: e2a 0x%x param_len %u > %u, clamped\n",
+				    em->id, em->param_len, room);
+		em->param_len = room;
+	}
+	return true;
+}
