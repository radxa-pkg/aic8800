+					/* vlan_idx comes from firmware (connect ind) */
+					rwnx_vif = sta->vlan_idx < NX_VIRT_DEV_MAX + NX_REMOTE_STA_MAX ? rwnx_hw->vif_table[sta->vlan_idx] : NULL;
 					if (!rwnx_vif) {
 						dev_kfree_skb(skb);
