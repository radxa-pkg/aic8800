@@ -472,8 +472,14 @@ static msg_cb_fct *msg_hdlrs[] = {
 
 void rwnx_rx_handle_msg(struct aic_sdio_dev *sdiodev, struct ipc_e2a_msg *msg)
 {
-	sdiodev->cmd_mgr.msgind(&sdiodev->cmd_mgr, msg,
-							msg_hdlrs[MSG_T(msg->id)][MSG_I(msg->id)]);
+	/* firmware-supplied id indexes the handler tables */
+	unsigned int t = MSG_T(msg->id), i = MSG_I(msg->id);
+	msg_cb_fct cb = NULL;
+
+	if (t == TASK_DBG && i < ARRAY_SIZE(dbg_hdlrs))
+		cb = dbg_hdlrs[i];
+	(void)msg_hdlrs;
+	sdiodev->cmd_mgr.msgind(&sdiodev->cmd_mgr, msg, cb);
 }
 
