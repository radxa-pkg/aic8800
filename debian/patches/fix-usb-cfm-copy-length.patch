-                         int reqcfm, lmac_msg_id_t reqid, void *cfm)
+/* copy the confirmation into the caller's buffer, never more than its real size
+ * (recorded per command at send time from sizeof(*cfm)) */
+#define RWNX_CFM_SZ(c) __builtin_choose_expr(__builtin_types_compatible_p(typeof(c), void *), (size_t)0, sizeof(*(c)))
+#define rwnx_send_msg(h, p, r, i, c) rwnx_send_msg_sz(h, p, r, i, c, RWNX_CFM_SZ(c))
+#define rwnx_send_msg1(h, p, r, i, c, d) rwnx_send_msg1_sz(h, p, r, i, c, d, RWNX_CFM_SZ(c))
+static int rwnx_send_msg_sz(struct rwnx_hw *rwnx_hw, const void *msg_params,
+						 int reqcfm, lmac_msg_id_t reqid, void *cfm, size_t cfm_len)
 {
     struct lmac_msg *msg;
     struct rwnx_cmd *cmd;
@@ -444,6 +449,7 @@ static int rwnx_send_msg(struct rwnx_hw *rwnx_hw, const void *msg_params,
     cmd->reqid   = reqid;
     cmd->a2e_msg = msg;
     cmd->e2a_msg = cfm;
+	cmd->e2a_len = cfm ? (u16)min_t(size_t, cfm_len, 0xffff) : 0;
     if (nonblock)
         cmd->flags = RWNX_CMD_FLAG_NONBLOCK;
     if (reqcfm)
@@ -491,8 +497,8 @@ static int rwnx_send_msg(struct rwnx_hw *rwnx_hw, const void *msg_params,
 }
 
 
-static int rwnx_send_msg1(struct rwnx_hw *rwnx_hw, const void *msg_params,
-                         int reqcfm, lmac_msg_id_t reqid, void *cfm, bool defer)
+static int rwnx_send_msg1_sz(struct rwnx_hw *rwnx_hw, const void *msg_params,
+						 int reqcfm, lmac_msg_id_t reqid, void *cfm, bool defer, size_t cfm_len)
 {
     struct lmac_msg *msg;
     struct rwnx_cmd *cmd;
@@ -521,6 +527,7 @@ static int rwnx_send_msg1(struct rwnx_hw *rwnx_hw, const void *msg_params,
     cmd->reqid   = reqid;
     cmd->a2e_msg = msg;
     cmd->e2a_msg = cfm;
+	cmd->e2a_len = cfm ? (u16)min_t(size_t, cfm_len, 0xffff) : 0;
     if (nonblock)
         cmd->flags = RWNX_CMD_FLAG_NONBLOCK;
     if (reqcfm)
