Description: fdrv/aic_load_fw usb: limit confirmation copy to the caller's cfm buffer size
 USB counterpart of "fdrv/bsp: limit confirmation copy to the caller's
 cfm buffer size": record sizeof(*cfm) in struct rwnx_cmd at send time
 in the USB fdrv (rwnx_msg_tx.c) and aic_load_fw (aicbluetooth_cmds.c)
 and have cmd_mgr_msgind() copy at most that many bytes.
Author: N Oliver <3945917+PixnBits@users.noreply.github.com>
Forwarded: no
Last-Update: 2026-10-26
---
 .../drivers/aic8800/aic8800_fdrv/rwnx_cmds.c   |  9 +++++++--
 .../drivers/aic8800/aic8800_fdrv/rwnx_cmds.h   |  1 +
 .../drivers/aic8800/aic8800_fdrv/rwnx_msg_tx.c | 15 +++++++++++----
 .../aic8800/aic_load_fw/aicbluetooth_cmds.c    | 18 ++++++++++++++----
 .../aic8800/aic_load_fw/aicbluetooth_cmds.h    |  1 +
 5 files changed, 34 insertions(+), 10 deletions(-)

diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.c b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.c
index 8dbb88e..d2bb711 100644
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.c
@@ -469,8 +469,13 @@ static int cmd_mgr_msgind(struct rwnx_cmd_mgr *cmd_mgr, struct rwnx_cmd_e2amsg *
                     msg->param_len = RWNX_CMD_E2AMSG_LEN_MAX;
                 }
 
-                if (cmd->e2a_msg && msg->param_len)
-                    memcpy(cmd->e2a_msg, &msg->param, msg->param_len);
+				if (cmd->e2a_msg && msg->param_len) {
+					u16 copy_len = min_t(u16, msg->param_len, cmd->e2a_len);
+					if (msg->param_len > cmd->e2a_len)
+						pr_warn_ratelimited("rwnx: cfm 0x%x len %u > buffer %u, truncated\n",
+								    msg->id, msg->param_len, cmd->e2a_len);
+					memcpy(cmd->e2a_msg, &msg->param, copy_len);
+				}
 
                 if (RWNX_CMD_WAIT_COMPLETE(cmd->flags))
                     cmd_complete(cmd_mgr, cmd);
diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.h b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.h
index 1a60e3f..a7df86c 100644
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.h
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.h
