 			memset(cur->data, 0, sizeof(uint8_t) * cur->len * 8);
 			memcpy(cur->data, p, cur->len * 8);
 			p += cur->len * 8;
@@ -1561,7 +1623,7 @@ int rwnx_plat_bin_fw_patch_table_upload_android(struct aic_usb_dev *usbdev, char
 
 	return ret;
 err:
