@@ -1548,7 +1598,19 @@ int rwnx_plat_bin_fw_patch_table_upload_android(struct aic_usb_dev *usbdev, char
 		if((cur->type )  >= 1000 || cur->len == 0) {//Temp Workaround
 			cur->len = 0;
 		}else{
+			/* payload must fit in the remaining file (also rules out len*8 overflow) */
+			if (cur->len > (uint32_t)(size - (p - rawdata)) / 8) {
