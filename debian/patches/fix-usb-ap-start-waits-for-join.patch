From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NomDeTom <nomdetom@protonmail.com>
Date: Fri, 23 Oct 2026 00:00:00 +0100
Subject: [PATCH] usb: hold an AP start briefly while a STA on the chip joins

On an AIC8800DC, an AP started while a STA on the same chip joins a network
can stop the firmware: the join's scan, or the next SM_DISCONNECT_REQ, is
never answered. rwnx_cfg80211_start_ap() now waits, at most 8 s, while a STA
vif is connecting and for 3 s after its last successful connect indication.
The STA's EAPOL frames go through the data path, so the wait doesn't hold up
the handshake; only installing its keys, which needs the wiphy lock held here,
can wait a little. A start that waited says so in the kernel log.
---
 src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_defs.h   |  1 +
 src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c   | 28 ++++++++++++++++++++++
 src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_msg_rx.c |  3 +++
 3 files changed, 32 insertions(+)

diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_defs.h b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_defs.h
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_defs.h
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_defs.h
@@ -792,6 +792,7 @@ struct rwnx_hw {
     #endif
     struct rwnx_survey_info survey[SCAN_CHANNEL_MAX];
     struct cfg80211_scan_request *scan_request;
+    unsigned long last_connect_ind;             /* jiffies of the last successful SM_CONNECT_IND; 0: none */
 #ifdef CONFIG_SCHED_SCAN
     struct cfg80211_sched_scan_request *sched_scan_req;
 #endif
diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c
@@ -4174,6 +4174,26 @@ static int rwnx_cfg80211_change_station(struct wiphy *wiphy,
     return 0;
 }
 
+/* An AP started while a STA on the same chip joins can stop the firmware (the DC: the join's scan, or the next
+ * SM_DISCONNECT_REQ, never answered). So an AP start waits, at most AP_START_WAIT_MAX_MS, while a STA is connecting
+ * and for AP_START_JOIN_SETTLE_MS after its connect indication. Only the STA's key installation, which needs the
+ * wiphy lock held here, waits with it: its EAPOL frames go through the data path. */
+#define AP_START_JOIN_SETTLE_MS	3000
+#define AP_START_WAIT_MAX_MS	8000
+
+static bool rwnx_sta_joining(struct rwnx_hw *rwnx_hw)
+{
+    struct rwnx_vif *vif;
+
+    list_for_each_entry(vif, &rwnx_hw->vifs, list) {
+        if (RWNX_VIF_TYPE(vif) == NL80211_IFTYPE_STATION &&
+            atomic_read(&vif->drv_conn_state) == (int)RWNX_DRV_STATUS_CONNECTING)
+            return true;
+    }
+    return rwnx_hw->last_connect_ind &&
+           time_before(jiffies, rwnx_hw->last_connect_ind + msecs_to_jiffies(AP_START_JOIN_SETTLE_MS));
+}
+
 /**
  * @start_ap: Start acting in AP mode defined by the parameters.
  */
@@ -4186,9 +4206,17 @@ static int rwnx_cfg80211_start_ap(struct wiphy *wiphy, struct net_device *dev,
     struct rwnx_ipc_elem_var elem;
     struct rwnx_sta *sta;
     int error = 0;
+    unsigned int waited = 0;
 
     RWNX_DBG(RWNX_FN_ENTRY_STR);
 
+    while (waited < AP_START_WAIT_MAX_MS && rwnx_sta_joining(rwnx_hw)) {
+        msleep(100);
+        waited += 100;
+    }
+    if (waited)
+        printk(KERN_INFO "aic8800: the AP start waited %u ms for a STA's join\n", waited);
+
     INIT_WORK(&rwnx_vif->sta_probe.apmprobestaWork, apm_probe_sta_work_process);
     rwnx_vif->sta_probe.apmprobesta_wq = create_singlethread_workqueue("apmprobe_wq");
     if (!rwnx_vif->sta_probe.apmprobesta_wq) {
diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_msg_rx.c b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_msg_rx.c
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_msg_rx.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_msg_rx.c
@@ -929,6 +929,9 @@ static inline int rwnx_rx_sm_connect_ind(struct rwnx_hw *rwnx_hw,
     RWNX_DBG(RWNX_FN_ENTRY_STR);
 
     aicwf_join_watch_stop();
+    if (!ind->status_code) {
+        rwnx_hw->last_connect_ind = jiffies ? jiffies : 1;
+    }
 	
 	if(!rwnx_vif){
 		AICWFDBG(LOGERROR, "%s rwnx_vif is null \r\n", __func__);
