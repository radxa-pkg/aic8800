From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NomDeTom <nomdetom@protonmail.com>
Date: Fri, 23 Oct 2026 00:00:00 +0100
Subject: [PATCH] usb: stop the command manager before the platform goes

The command worker's diagnostic reads (the firmware's state at a deferred
command's timeout) use usbdev->rwnx_hw, and its queue accounting releases
rwnx_hw->ws_tx. The worker was only flushed in rwnx_cmd_mgr_deinit(), after
rwnx_cfg80211_deinit() had destroyed the wakeup sources and freed the wiphy,
which holds rwnx_hw.

rwnx_cmd_mgr_quiesce() now runs in rwnx_cfg80211_deinit() once
wiphy_unregister() has returned (the last commands of a teardown are sent
before that), and on rwnx_cfg80211_init()'s failure path, before the wakeup
sources and the wiphy go:

- the manager is marked as being torn down (RWNX_CMD_MGR_STATE_DEINIT), so
  cmd_mgr_queue() and cmd_mgr_queue_force_defer() refuse new commands with
  -EPIPE, without a reset;
- the queued commands are drained, their waiters woken;
- the worker is flushed, so a command it is waiting on, or a timeout it is
  handling, ends while rwnx_hw is still there.

A timeout handled meanwhile neither marks the manager crashed nor resets the
device. The drain now unlinks through cmd_unqueue(), as the waiters do, so
each command leaves the queue once and queue_sz stays right.
---
 src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.c | 40 +++++++++++++++++++++---
 src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.h |  1 +
 src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c |  2 ++
 3 files changed, 38 insertions(+), 5 deletions(-)

diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.c b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.c
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.c
@@ -292,7 +292,7 @@ static void cmd_mgr_reset_device(struct rwnx_cmd_mgr *cmd_mgr)
     struct aic_usb_dev *usbdev = container_of(cmd_mgr, struct aic_usb_dev, cmd_mgr);
     struct aicwf_port *port;
 
-    if (!usbdev->intf)
+    if (!usbdev->intf || cmd_mgr->state == RWNX_CMD_MGR_STATE_DEINIT)
         return;
     spin_lock_bh(&aicwf_ports_lock);
     port = aicwf_port_of(usbdev->udev);
@@ -358,6 +358,11 @@ int cmd_mgr_queue_force_defer(struct rwnx_cmd_mgr *cmd_mgr, struct rwnx_cmd *cmd
 #endif
     spin_lock_bh(&cmd_mgr->lock);
 
+    if (cmd_mgr->state == RWNX_CMD_MGR_STATE_DEINIT) {
+        cmd->result = -EPIPE;
+        spin_unlock_bh(&cmd_mgr->lock);
+        return -EPIPE;
+    }
     if (cmd_mgr->state == RWNX_CMD_MGR_STATE_CRASHED) {
         printk(KERN_CRIT"cmd queue crashed\n");
         cmd->result = -EPIPE;
@@ -425,6 +430,11 @@ static int cmd_mgr_queue(struct rwnx_cmd_mgr *cmd_mgr, struct rwnx_cmd *cmd)
     if(cmd->e2a_msg != NULL) {
         do {
 			spin_lock_bh(&cmd_mgr->lock);
+			if (cmd_mgr->state == RWNX_CMD_MGR_STATE_DEINIT) {
+				cmd->result = -EPIPE;
+				spin_unlock_bh(&cmd_mgr->lock);
+				return -EPIPE;
+			}
 			if(cmd_mgr->state == RWNX_CMD_MGR_STATE_CRASHED) {
 				AICWFDBG(LOGERROR, "cmd queue crashed\n");
 				cmd->result = -EPIPE;
@@ -451,6 +461,11 @@ static int cmd_mgr_queue(struct rwnx_cmd_mgr *cmd_mgr, struct rwnx_cmd *cmd)
         } while(!empty);//wait for cmd queue empty
     } else {
 			spin_lock_bh(&cmd_mgr->lock);
+			if (cmd_mgr->state == RWNX_CMD_MGR_STATE_DEINIT) {
+				cmd->result = -EPIPE;
+				spin_unlock_bh(&cmd_mgr->lock);
+				return -EPIPE;
+			}
 			if (cmd_mgr->state == RWNX_CMD_MGR_STATE_CRASHED) {
 				printk(KERN_CRIT"cmd queue crashed\n");
 				cmd->result = -EPIPE;
@@ -579,7 +594,8 @@ static int cmd_mgr_queue(struct rwnx_cmd_mgr *cmd_mgr, struct rwnx_cmd *cmd)
 
             cmd_dump(cmd);
             spin_lock_bh(&cmd_mgr->lock);
-            cmd_mgr->state = RWNX_CMD_MGR_STATE_CRASHED;
+            if (cmd_mgr->state != RWNX_CMD_MGR_STATE_DEINIT)
+                cmd_mgr->state = RWNX_CMD_MGR_STATE_CRASHED;
             if (cmd_mgr->queue_sz == 0)
                 rwnx_wakeup_unlock(usbdev->rwnx_hw->ws_tx);
             if (!(cmd->flags & RWNX_CMD_FLAG_DONE)) {
@@ -709,7 +725,8 @@ void cmd_mgr_task_process(struct work_struct *work)
                 if (empty)
                     cmd_mgr_log_fw_state(usbdev, next->id);
                 spin_lock_bh(&cmd_mgr->lock);
-                cmd_mgr->state = RWNX_CMD_MGR_STATE_CRASHED;
+                if (cmd_mgr->state != RWNX_CMD_MGR_STATE_DEINIT)
+                    cmd_mgr->state = RWNX_CMD_MGR_STATE_CRASHED;
                 if (cmd_mgr->queue_sz == 0)
                     rwnx_wakeup_unlock(usbdev->rwnx_hw->ws_tx);
                 spin_unlock_bh(&cmd_mgr->lock);
@@ -831,8 +848,7 @@ static void cmd_mgr_drain(struct rwnx_cmd_mgr *cmd_mgr)
 
     spin_lock_bh(&cmd_mgr->lock);
     list_for_each_entry_safe(cur, nxt, &cmd_mgr->cmds, list) {
-        list_del_init(&cur->list);
-        //cmd_mgr->queue_sz--;
+        cmd_unqueue(cmd_mgr, cur);
         if (!(cur->flags & RWNX_CMD_FLAG_NONBLOCK))
             complete(&cur->complete);
     }
@@ -867,6 +883,20 @@ void rwnx_cmd_mgr_init(struct rwnx_cmd_mgr *cmd_mgr)
     }
 }
 
+/* Before the platform goes (rwnx_cfg80211_deinit(), and its init's failure path): no command taken any more, those
+ * queued woken, and the command worker finished, while rwnx_hw and its wakeup sources, which the worker uses, are
+ * still there. A timeout meanwhile neither marks the manager crashed nor resets the device. */
+void rwnx_cmd_mgr_quiesce(struct rwnx_cmd_mgr *cmd_mgr)
+{
+    if (!cmd_mgr || !cmd_mgr->cmd_wq)
+        return;
+    spin_lock_bh(&cmd_mgr->lock);
+    cmd_mgr->state = RWNX_CMD_MGR_STATE_DEINIT;
+    spin_unlock_bh(&cmd_mgr->lock);
+    cmd_mgr->drain(cmd_mgr);
+    flush_workqueue(cmd_mgr->cmd_wq);
+}
+
 void rwnx_cmd_mgr_deinit(struct rwnx_cmd_mgr *cmd_mgr)
 {
     if(cmd_mgr->print && cmd_mgr->drain){
diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.h b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.h
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.h
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.h
@@ -113,6 +113,7 @@ struct rwnx_cmd_mgr {
     } while (0)
 
 void rwnx_cmd_mgr_init(struct rwnx_cmd_mgr *cmd_mgr);
+void rwnx_cmd_mgr_quiesce(struct rwnx_cmd_mgr *cmd_mgr);
 void rwnx_cmd_mgr_deinit(struct rwnx_cmd_mgr *cmd_mgr);
 struct rwnx_hw;
 void aicwf_join_watch_start(struct rwnx_hw *rwnx_hw);
diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c
@@ -9603,6 +9603,7 @@ err_lmac_reqs:
 //err_platon:
 //err_config:
 err_cache:
+    rwnx_cmd_mgr_quiesce(rwnx_hw->cmd_mgr);
     aicwf_wakeup_lock_deinit(rwnx_hw);
     wiphy_free(wiphy);
 err_out:
@@ -9680,6 +9681,7 @@ void rwnx_cfg80211_deinit(struct rwnx_hw *rwnx_hw)
 		AICWFDBG(LOGINFO, "%s wiphy_unregister \r\n", __func__);
     	wiphy_unregister(rwnx_hw->wiphy);
 	}
+    rwnx_cmd_mgr_quiesce(rwnx_hw->cmd_mgr);
     rwnx_radar_detection_deinit(&rwnx_hw->radar);
     rwnx_platform_off(rwnx_hw, NULL);
     kmem_cache_destroy(rwnx_hw->sw_txhdr_cache);
